{
  "name": "purdue-af",
  "displayName": "Purdue AF",
  "description": "Connect to Purdue AF JupyterHub pods with flexible authentication options",
  "version": "0.4.1",
  "publisher": "purdue-af",
  "repository": {
    "type": "git",
    "url": "https://github.com/purdue-af/vscode-k8s-connector.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:purdueAf.connect",
    "onCommand:purdueAf.disconnect"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "purdueAf.connect",
        "title": "Connect to Purdue AF",
        "category": "Purdue AF"
      },
      {
        "command": "purdueAf.disconnect",
        "title": "Disconnect from Purdue AF",
        "category": "Purdue AF"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "purdueAf.connect",
          "when": "!purdueAf.connected"
        },
        {
          "command": "purdueAf.disconnect",
          "when": "purdueAf.connected"
        }
      ]
    },
    "configuration": {
      "title": "Purdue AF",
      "properties": {
        "purdueAf.brokerUrl": {
          "type": "string",
          "default": "https://purdue-af-broker.geddes.rcac.purdue.edu",
          "description": "URL of the broker service"
        },
        "purdueAf.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect on startup"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "undici": "^6.19.0",
    "vsce": "^1.95.0"
  }
}
